# Hojo-ASR-only whisper backend container — split out from the primary
# whisper container because hojo-asr itself declares torch>=2.5.1,<2.6 /
# torchaudio>=2.5.1,<2.6, incompatible with ml-base's torch>=2.6.0 (shared
# by every other backend). Built from scratch, NOT from mbrede/ai-apis-base
# — that base already has torch>=2.6.0 baked in, too late to downgrade
# once inherited. See whisper_api.py's module docstring for the
# LOCAL_BACKENDS/proxy design, and pyproject.toml's whisper-hojoasr-only
# extra for the exact pin chain (whisperx and pyannote-audio both had to be
# capped to older majors too — see that extra's comments).
FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_CACHE=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    ffmpeg \
    git \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

COPY pyproject.toml README.md /app/
RUN uv pip install -e "/app[whisper-hojoasr]"

COPY src/core/ /app/src/core/
COPY src/audio/ /app/src/audio/
COPY .env.example /app/.env

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENV WHISPER_LOCAL_BACKENDS="hojo-asr"

CMD ["gunicorn", "src.audio.whisper_api:app", \
     "--workers", "1", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8080", \
     "--timeout", "30000"]
