# Whisper API Docker image using pre-built base from Docker Hub
# Base image already contains: Python, CUDA, uv, system packages, api-core (FastAPI etc.), ml-base (torch, numpy)
#
# To use this Dockerfile:
# 1. Build and push base image: ./scripts/build_and_push_base.sh 1.0.0 yourusername
# 2. Build: docker build -f docker/Dockerfile.whisper.hub -t ai_apis_whisper:latest .

# Use pre-built base image from Docker Hub
FROM mbrede/ai-apis-base:latest

WORKDIR /app

# Install only service-specific packages (base already has api-core and ml-base)
# This installs: openai-whisper, pyannote-audio, ffmpeg-python
COPY pyproject.toml README.md /app/
# --prerelease=allow: whisperx's stable releases (<=3.8.6) pin
# huggingface-hub<1.0.0, incompatible with transformers>=5.8 (needed by the
# Granite-Speech backend, which itself requires huggingface-hub>=1.5.0).
# whisperx==3.8.7rc1 drops that pin (huggingface-hub>=0.28.1, no upper
# bound) — resolves cleanly, no --no-deps hack needed for whisperx itself.
RUN UV_HTTP_TIMEOUT=300 uv pip install --prerelease=allow -e "/app[whisper-only]"
# qwen-asr pins transformers==4.57.6 (conflicts with whisper-only's
# transformers>=5.8, needed by the Granite-Speech backend); hojo-asr pins
# torch<2.6 (conflicts with the base image's torch>=2.6.0). Both installed
# with --no-deps so neither downgrades transformers/torch out from under
# the rest of the container; their own code is expected to work fine
# against the newer pins, the upstream pins are just conservative. See
# Dockerfile.whisper's identical comment.
RUN uv pip install --no-deps qwen-asr hojo-asr

# Copy source code
COPY src/core/ /app/src/core/
COPY src/audio/ /app/src/audio/

# Expose port
EXPOSE 8080


# Run the API
CMD ["gunicorn", "src.audio.whisper_api:app", \
     "--workers", "1", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8080", \
     "--timeout", "30000"]
